{
  "name": "flappy-hippo",
  "private": true,
  "version": "1.4.0",
  "description": "A flying hippo, one button, no account: a Flappy game as an installable web app.",
  "license": "MIT",
  "author": "Steffen Kühne",
  "homepage": "https://stekhn.github.io/flappy-hippo/",
  "repository": {
    "type": "git",
    "url": "https://github.com/stekhn/flappy-hippo.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "node --test \"src/*/*.test.ts\" \"src/*/*/*.test.ts\"",
    "assets": "node --experimental-strip-types scripts/make-assets.ts",
    "screenshots": "node --experimental-strip-types scripts/make-screenshots.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
